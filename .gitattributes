* text=auto eol=lf

# Deterministic project metadata and scripts use LF on every platform.
/.github/** text eol=lf
/docs/** text eol=lf
/scripts/** text eol=lf
/tests/** text eol=lf
/third_party/** text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Windows launchers remain conventional CRLF files.
*.bat text eol=crlf

# Keep this after every extension rule: vendored snapshots must retain the
# upstream archive's exact bytes. TwinQuill-authored patch files are LF text.
/vendor/** -text -eol -working-tree-encoding
/vendor/patches/** text eol=lf

# Audited font assets and their license files are hash-verified snapshots.
/third_party/fonts/** -text -eol -working-tree-encoding
