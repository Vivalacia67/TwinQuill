* text=auto eol=lf

# Vendored snapshots must retain the upstream archive's exact bytes.
/vendor/** -text
/vendor/patches/** text eol=lf

# Deterministic project metadata and scripts use LF on every platform.
/.github/** text eol=lf
/docs/** text eol=lf
/scripts/** text eol=lf
/tests/** text eol=lf
/third_party/** text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Windows launchers remain conventional CRLF files.
*.bat text eol=crlf
